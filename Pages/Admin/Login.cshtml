@page "/admin/login"
@model TxTextControl.McpServer.Pages.Admin.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login - TX MCP</title>
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            background: #f6f8fb;
            color: #172033;
            font-family: Arial, Helvetica, sans-serif;
        }

        .panel {
            width: min(420px, calc(100vw - 32px));
            background: #fff;
            border: 1px solid #d9e0ea;
            border-radius: 8px;
            box-shadow: 0 18px 45px rgba(16, 24, 40, .08);
            padding: 28px;
        }

        .brand {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 22px;
        }

        .brand-logo {
            width: 54px;
            height: 42px;
            object-fit: contain;
            border-radius: 8px;
            background: #fff;
            padding: 4px;
        }

        h1 {
            margin: 0;
            font-size: 24px;
            letter-spacing: 0;
        }

        p {
            margin: 6px 0 0;
            color: #667085;
        }

        label {
            display: block;
            margin: 16px 0 6px;
            font-weight: 700;
        }

        input {
            width: 100%;
            min-height: 42px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 9px 11px;
            font: inherit;
        }

        input:focus {
            outline: 3px solid #ccfbf1;
            border-color: #0f766e;
        }

        button {
            width: 100%;
            min-height: 44px;
            margin-top: 20px;
            border: 0;
            border-radius: 8px;
            background: #0f766e;
            color: #fff;
            font: inherit;
            font-weight: 800;
            cursor: pointer;
        }

        .error {
            margin-top: 16px;
            padding: 10px 12px;
            border: 1px solid #fecdca;
            border-radius: 8px;
            background: #fef3f2;
            color: #b42318;
            font-weight: 700;
        }
    </style>
    <link rel="stylesheet" href="/css/mcp-admin.css" />
</head>
<body class="admin-login-body">
    <main class="panel login-panel">
        <div class="brand">
            <img class="brand-logo" src="/assets/txai.svg" alt="Text Control AI" />
            <div>
                <h1>Admin Login</h1>
                <p>MCP Document Server</p>
            </div>
        </div>

        <form method="post">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" autocomplete="username" autofocus />

            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" />

            <button type="submit">Sign In</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error">@Model.ErrorMessage</div>
        }
    </main>
</body>
</html>
