@page "/admin/mcp"
@model TxTextControl.McpServer.Pages.Admin.McpModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MCP Endpoint - TX MCP Admin</title>
    <link rel="stylesheet" href="/css/mcp-admin.css" />
</head>
<body>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="shell">
        <aside>
            <a class="brand" href="/admin" aria-label="TX Text Control MCP administration">
                <img class="brand-logo" src="/assets/txai.svg" alt="Text Control AI" />
                <span class="brand-copy"><strong>MCP Document Server</strong><small>Administration</small></span>
            </a>
            <nav aria-label="Admin navigation">
                <a href="/admin">Automation</a>
                <a href="/admin/settings">Settings</a>
                <a href="/admin/styles">Style presets</a>
                <a class="active" href="/admin/mcp">MCP endpoint</a>
                <a href="/admin/automation">JSON</a>
                <a href="/admin/logout">Sign out</a>
            </nav>
        </aside>
        <main>
            <header class="topbar">
                <div><span class="eyebrow">CLIENT CONNECTION</span><h1>MCP endpoint</h1><p class="subtle">Connect an AI client to the document automation server over Streamable HTTP.</p></div>
            </header>
            <section class="panel mcp-panel">
                <div class="panel-header"><div><h2>Connection URL</h2><p>Use this address in clients that support Model Context Protocol over HTTP.</p></div><span class="badge">Online</span></div>
                <div class="endpoint"><span class="method">POST</span><code id="endpoint-url">@Model.EndpointUrl</code></div>
                <div class="endpoint-actions">
                    <button class="primary" type="button" id="copy-endpoint">Copy endpoint</button>
                    <a class="button" href="/">Server status</a>
                    <a class="button" href="/admin/automation">Inspect JSON</a>
                </div>
                <p class="subtle endpoint-note">Opening the MCP URL directly in a browser sends a GET request and correctly returns <code>405 Method Not Allowed</code>. MCP clients communicate with POST requests.</p>
            </section>
        </main>
        <footer class="admin-footer"><span><strong>Text Control</strong> · Document processing for intelligent applications</span><span>TX Text Control Document MCP Server</span></footer>
    </div>
    <script>
        document.getElementById('copy-endpoint')?.addEventListener('click', async (event) => {
            await navigator.clipboard.writeText(document.getElementById('endpoint-url').textContent.trim());
            const button = event.currentTarget;
            const label = button.textContent;
            button.textContent = 'Copied';
            window.setTimeout(() => button.textContent = label, 1400);
        });
    </script>
</body>
</html>
