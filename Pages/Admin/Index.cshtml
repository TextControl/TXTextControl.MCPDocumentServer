@page "/admin"
@model TxTextControl.McpServer.Pages.Admin.IndexModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TX MCP Admin - Beta 1</title>
    <style>
        :root {
            color-scheme: light;
            --bg: #f6f8fb;
            --panel: #ffffff;
            --ink: #172033;
            --muted: #667085;
            --line: #d9e0ea;
            --brand: #0f766e;
            --brand-strong: #115e59;
            --danger: #b42318;
            --soft: #eef6f5;
            --shadow: 0 18px 45px rgba(16, 24, 40, .08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font-family: Arial, Helvetica, sans-serif;
            font-size: 15px;
        }

        .shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 280px minmax(0, 1fr);
        }

        aside {
            background: #172033;
            color: #fff;
            padding: 28px 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 34px;
        }

        .brand-logo {
            width: 52px;
            height: 40px;
            object-fit: contain;
            border-radius: 8px;
            background: #fff;
            padding: 5px;
        }

        .brand strong {
            display: block;
            font-size: 16px;
        }

        .brand span {
            display: block;
            color: #a8b3c7;
            font-size: 12px;
            margin-top: 2px;
        }

        nav a {
            display: block;
            color: #d6deea;
            text-decoration: none;
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 6px;
        }

        nav a.active {
            background: rgba(255, 255, 255, .12);
            color: #fff;
        }

        main {
            padding: 28px;
        }

        .topbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 22px;
        }

        .top-logo {
            width: 54px;
            height: 40px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        h1 {
            font-size: 30px;
            line-height: 1.1;
            margin: 0 0 8px;
            letter-spacing: 0;
        }

        .subtle {
            color: var(--muted);
            margin: 0;
            max-width: 760px;
        }

        .actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        button,
        .button {
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 10px 14px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            white-space: nowrap;
        }

        button.primary {
            background: var(--brand);
            color: #fff;
        }

        button.primary:hover {
            background: var(--brand-strong);
        }

        .button {
            border-color: var(--line);
            color: var(--ink);
            background: #fff;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .stat {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 16px;
            box-shadow: var(--shadow);
        }

        .stat span {
            display: block;
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: .06em;
        }

        .stat strong {
            display: block;
            margin-top: 8px;
            font-size: 28px;
        }

        .notice {
            background: #ecfdf3;
            border: 1px solid #abefc6;
            color: #067647;
            border-radius: 8px;
            padding: 12px 14px;
            margin-bottom: 18px;
            font-weight: 700;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 18px;
            overflow: hidden;
        }

        .panel-header {
            padding: 18px 20px;
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .panel-header h2 {
            font-size: 18px;
            margin: 0;
        }

        .panel-header p {
            margin: 4px 0 0;
            color: var(--muted);
        }

        .pack-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            padding: 18px;
        }

        .pack-card {
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 14px;
            background: #fff;
        }

        .pack-card.enabled {
            border-color: #99d6cf;
            background: var(--soft);
        }

        .row {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            justify-content: space-between;
        }

        .pack-card h3,
        .operation h3 {
            margin: 0;
            font-size: 15px;
        }

        .pack-card p,
        .operation p {
            margin: 8px 0 0;
            color: var(--muted);
            line-height: 1.4;
        }

        .switch {
            position: relative;
            width: 44px;
            min-width: 44px;
            height: 24px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background: #cbd5e1;
            transition: .15s;
            border-radius: 999px;
        }

        .slider:before {
            content: "";
            position: absolute;
            height: 18px;
            width: 18px;
            left: 3px;
            top: 3px;
            background: #fff;
            transition: .15s;
            border-radius: 50%;
            box-shadow: 0 1px 3px rgba(16, 24, 40, .25);
        }

        .switch input:checked + .slider {
            background: var(--brand);
        }

        .switch input:checked + .slider:before {
            transform: translateX(20px);
        }

        .operation-group {
            border-top: 1px solid var(--line);
        }

        .operation-group:first-of-type {
            border-top: 0;
        }

        .group-title {
            padding: 14px 20px;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .group-title h3 {
            margin: 0;
            font-size: 14px;
        }

        .group-title span {
            color: var(--muted);
            font-size: 13px;
        }

        .operation {
            display: grid;
            grid-template-columns: minmax(190px, .7fr) minmax(0, 1.3fr) 150px 70px;
            gap: 16px;
            align-items: center;
            padding: 14px 20px;
            border-top: 1px solid var(--line);
        }

        code {
            display: inline-block;
            background: #eef2f7;
            border-radius: 6px;
            padding: 3px 6px;
            font-family: Consolas, "Courier New", monospace;
            font-size: 13px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 24px;
            border-radius: 999px;
            padding: 3px 10px;
            font-size: 12px;
            font-weight: 700;
            background: #eef6f5;
            color: var(--brand-strong);
        }

        .badge.off {
            background: #fef3f2;
            color: var(--danger);
        }

        .footer-actions {
            position: sticky;
            bottom: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 20px;
            background: rgba(246, 248, 251, .92);
            border-top: 1px solid var(--line);
            backdrop-filter: blur(10px);
        }

        @@media (max-width: 980px) {
            .shell {
                grid-template-columns: 1fr;
            }

            aside {
                display: none;
            }

            .topbar,
            .footer-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .stats,
            .pack-grid {
                grid-template-columns: 1fr;
            }

            .operation {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/mcp-admin.css" />
</head>
<body>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="shell">
        <aside>
            <div class="brand">
                <img class="brand-logo" src="/assets/txai.svg" alt="Text Control AI" />
                <div class="brand-copy">
                    <strong>MCP Document Server</strong>
                    <span>Administration</span>
                </div>
            </div>
            <nav aria-label="Admin navigation">
                <a class="active" href="/admin">Automation</a>
                <a href="/admin/settings">Settings</a>
                <a href="/admin/styles">Style presets</a>
                <a href="/admin/mcp">MCP endpoint</a>
                <a href="/admin/automation">JSON</a>
                <a href="/admin/logout">Sign out</a>
            </nav>
        </aside>
        <main>
            <form method="post">
                <div class="topbar">
                    <div>
                        <img class="top-logo" src="/assets/txai.svg" alt="Text Control AI" />
                        <span class="eyebrow">MCP CAPABILITIES</span>
                        <h1>Document automation</h1>
                        <p class="subtle">Control which capability packs and individual MCP document operations are available to AI clients.</p>
                    </div>
                    <div class="actions">
                        <a class="button" href="/admin/automation">View JSON</a>
                        <button class="primary" type="submit">Save Changes</button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                {
                    <div class="notice">@Model.StatusMessage</div>
                }

                <section class="stats" aria-label="Automation summary">
                    <div class="stat">
                        <span>Capability Packs</span>
                        <strong>@Model.EnabledPackCount / @Model.CapabilityPacks.Count</strong>
                    </div>
                    <div class="stat">
                        <span>Enabled Operations</span>
                        <strong>@Model.EnabledOperationCount / @Model.TotalOperationCount</strong>
                    </div>
                    <div class="stat">
                        <span>Configuration</span>
                        <strong>Live</strong>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <h2>Capability Packs</h2>
                            <p>Packs are the coarse feature gates. A disabled pack disables all operations inside it.</p>
                        </div>
                    </div>
                    <div class="pack-grid">
                        @foreach (var pack in Model.CapabilityPacks)
                        {
                            <article class="pack-card @(pack.Enabled ? "enabled" : "")">
                                <div class="row">
                                    <div>
                                        <h3>@pack.Name</h3>
                                        <p>@pack.Description</p>
                                    </div>
                                    <label class="switch" aria-label="Enable @pack.Name">
                                        <input type="checkbox" name="EnabledCapabilityPacks" value="@pack.Name" checked="@pack.Enabled" />
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                <p>@pack.OperationTypes.Count operations</p>
                            </article>
                        }
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <h2>Enabled Operations</h2>
                            <p>Fine tune the exact operations exposed through the MCP automation tools.</p>
                        </div>
                    </div>
                    @foreach (var group in Model.OperationGroups)
                    {
                        <div class="operation-group">
                            <div class="group-title">
                                <h3>@group.Key</h3>
                                <span>@group.Count(operation => operation.IsEffective) of @group.Count() active</span>
                            </div>
                            @foreach (var operation in group)
                            {
                                <article class="operation">
                                    <div>
                                        <h3><code>@operation.Type</code></h3>
                                    </div>
                                    <div>
                                        <p>@operation.Description</p>
                                        @if (!string.IsNullOrWhiteSpace(operation.Intent))
                                        {
                                            <p>@operation.Intent</p>
                                        }
                                    </div>
                                    <div>
                                        <span class="badge @(operation.IsEffective ? "" : "off")">@(operation.IsEffective ? "Effective" : "Disabled")</span>
                                    </div>
                                    <label class="switch" aria-label="Enable @operation.Type">
                                        <input type="checkbox" name="EnabledOperations" value="@operation.Type" checked="@operation.IsSelected" />
                                        <span class="slider"></span>
                                    </label>
                                </article>
                            }
                        </div>
                    }
                </section>

                <div class="footer-actions">
                    <span class="subtle">Changes are written to <code>appsettings.json</code> and applied to the running registry.</span>
                    <button class="primary" type="submit">Save Changes</button>
                </div>
            </form>
        </main>
        <footer class="admin-footer"><span><strong>Text Control</strong> · Document processing for intelligent applications</span><span>TX Text Control Document MCP Server</span></footer>
    </div>
</body>
</html>
