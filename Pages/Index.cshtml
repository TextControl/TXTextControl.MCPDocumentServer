@page
@model TxTextControl.McpServer.Pages.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TX Text Control Document MCP Server Running</title>
    <style>
        :root {
            --bg: #0f172a;
            --panel: #ffffff;
            --ink: #162033;
            --muted: #667085;
            --line: #d9e0ea;
            --accent: #0f766e;
            --accent-soft: #ccfbf1;
            --blue: #1f4e79;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 32px;
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at top left, rgba(20, 184, 166, .22), transparent 32rem),
                linear-gradient(135deg, #0b1120 0%, var(--bg) 55%, #172033 100%);
        }

        .status-card {
            width: min(760px, 100%);
            border: 1px solid rgba(255, 255, 255, .35);
            border-radius: 18px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 28px 80px rgba(2, 6, 23, .35);
            overflow: hidden;
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 26px 30px;
            border-bottom: 1px solid var(--line);
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        }

        .logo {
            width: 72px;
            height: 52px;
            object-fit: contain;
            border-radius: 10px;
            border: 1px solid var(--line);
            background: #fff;
            padding: 6px;
        }

        h1 {
            margin: 0;
            font-size: clamp(28px, 4vw, 42px);
            line-height: 1;
            letter-spacing: 0;
            color: var(--blue);
        }

        .subtitle {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 15px;
        }

        .card-body {
            padding: 30px;
        }

        .running-box {
            display: grid;
            gap: 10px;
            padding: 18px;
            border: 1px solid #99f6e4;
            border-radius: 12px;
            background: var(--accent-soft);
        }

        .status-line {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #115e59;
            font-weight: 800;
        }

        .pulse {
            width: 12px;
            height: 12px;
            border-radius: 999px;
            background: var(--accent);
            box-shadow: 0 0 0 6px rgba(15, 118, 110, .12);
        }

        .server-url {
            display: block;
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #5eead4;
            border-radius: 8px;
            background: #fff;
            color: #0f172a;
            font-family: Consolas, "Courier New", monospace;
            font-size: 15px;
            word-break: break-all;
        }

        .links {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 22px;
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 0 16px;
            border-radius: 8px;
            border: 1px solid var(--line);
            color: var(--ink);
            background: #fff;
            text-decoration: none;
            font-weight: 700;
        }

        .button.primary {
            border-color: var(--blue);
            background: var(--blue);
            color: #fff;
        }

        .meta {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-top: 24px;
        }

        .meta-item {
            padding: 14px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: #f8fafc;
        }

        .meta-item span {
            display: block;
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .meta-item strong {
            display: block;
            margin-top: 6px;
            font-size: 15px;
        }

        @@media (max-width: 640px) {
            body {
                padding: 18px;
            }

            .card-header,
            .card-body {
                padding: 22px;
            }

            .card-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .meta {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/mcp-admin.css" />
</head>
<body class="server-status-body">
    <main class="status-card">
        <header class="card-header">
            <img class="logo" src="/assets/txai.svg" alt="Text Control AI" />
            <div>
                <h1>MCP Server is running...</h1>
                <p class="subtitle">TX Text Control document automation endpoint is ready for AI clients.</p>
            </div>
        </header>

        <section class="card-body">
            <div class="running-box">
                <div class="status-line">
                    <span class="pulse" aria-hidden="true"></span>
                    Listening on
                </div>
                <code class="server-url">@Model.ServerUrl</code>
            </div>

            <div class="links" aria-label="Server links">
                <a class="button primary" href="/admin">Open Admin</a>
                <a class="button" href="/mcp">MCP Endpoint</a>
            </div>

            <div class="meta" aria-label="Server details">
                <div class="meta-item">
                    <span>Status</span>
                    <strong>Online</strong>
                </div>
                <div class="meta-item">
                    <span>Transport</span>
                    <strong>HTTP MCP</strong>
                </div>
                <div class="meta-item">
                    <span>Document Format</span>
                    <strong>Internal Unicode</strong>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
