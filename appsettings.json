        "bodyCellStyle": {
          "backgroundColorHex": "#ffffff",
          "border": {
            "width": 10,
            "colorHex": "#d0d5dd",
            "left": null,
            "top": null,
            "right": null,
            "bottom": null
          }
        },
        "alternatingRowStyle": null,
        "alternatingRowCellStyle": {
          "backgroundColorHex": "#f8fafc",
          "border": {
            "width": 10,
            "colorHex": "#d0d5dd",
            "left": null,
            "top": null,
            "right": null,
            "bottom": null
          }
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
