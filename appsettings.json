{
  "McpServer": {
    "Name": "TX Text Control Document Server MCP",
    "BasePath": "MyDocuments",
    "SessionMaxAgeHours": 12
  },
  "Admin": {
    "Username": "admin",
    "Password": "admin"
  },
  "DocumentAutomation": {
    "EnabledCapabilityPacks": [
      "BasicText",
      "Media",
      "Tables",
      "Fields",
      "Sections",
      "HeaderFooter"
    ],
    "EnabledOperations": [
      "define_style",
      "append_paragraph",
      "apply_style_to_paragraph",
      "format_paragraphs",
      "format_text_occurrences",
      "replace_text",
      "append_image",
      "append_table",
      "set_table_cell_text",
      "format_table_cell",
      "format_table_header_row",
      "format_table_column",
      "apply_table_style_preset",
      "add_table_row",
      "append_merge_field",
      "update_merge_field",
      "clear_application_fields",
      "append_merge_block",
      "append_form_field",
      "update_form_field",
      "clear_form_fields",
      "insert_section_break",
      "set_section_layout",
      "set_header_footer"
    ],
    "DefaultParagraphStyleName": "Body",
    "StyleRoles": {
      "title": "Title",
      "heading1": "Heading",
      "heading2": "Heading2",
      "body": "Body"
    },
    "StylePresets": [
      {
        "name": "Title",
        "fontName": "Liberation Sans",
        "fontSize": 30,
        "fontSizeUnit": "pt",
        "bold": true,
        "italic": true,
        "underline": false,
        "colorHex": "#1f4e79",
        "paragraph": {
          "alignment": null,
          "spaceBefore": 0,
          "spaceAfter": 16,
          "lineSpacing": null,
          "unit": "pt"
        }
      },
      {
        "name": "Heading",
        "fontName": "Liberation Sans",
        "fontSize": 20,
        "fontSizeUnit": "px",
        "bold": true,
        "italic": false,
        "underline": false,
        "colorHex": "#000000",
        "paragraph": {
          "alignment": null,
          "spaceBefore": 0,
          "spaceAfter": 12,
          "lineSpacing": null,
          "unit": "pt"
        }
      },
      {
        "name": "Heading2",
        "fontName": "Liberation Sans",
        "fontSize": 16,
        "fontSizeUnit": "pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "colorHex": "#344054",
        "paragraph": {
          "alignment": null,
          "spaceBefore": 10,
          "spaceAfter": 8,
          "lineSpacing": null,
          "unit": "pt"
        }
      },
      {
        "name": "Body",
        "fontName": "Liberation Sans",
        "fontSize": 12,
        "fontSizeUnit": "px",
        "bold": false,
        "italic": false,
        "underline": false,
        "colorHex": "#000000",
        "paragraph": {
          "alignment": null,
          "spaceBefore": 0,
          "spaceAfter": 6,
          "lineSpacing": null,
          "unit": "pt"
        }
      }
    ],
    "TableStylePresets": [
      {
        "name": "Professional Blue",
        "headerRowIndex": 0,
        "headerStyle": {
          "name": "",
          "fontName": "Liberation Sans",
          "fontSize": 10,
          "fontSizeUnit": "pt",
          "bold": true,
          "italic": null,
          "underline": null,
          "colorHex": "#ffffff",
          "paragraph": null
        },
        "headerCellStyle": {
          "backgroundColorHex": "#1f4e79",
          "border": {
            "width": 10,
            "colorHex": "#d0d5dd",
            "left": null,
            "top": null,
            "right": null,
            "bottom": null
          }
        },
        "bodyStyle": {
          "name": "",
          "fontName": "Liberation Sans",
          "fontSize": 10,
          "fontSizeUnit": "pt",
          "bold": false,
          "italic": null,
          "underline": null,
          "colorHex": "#111827",
          "paragraph": null
