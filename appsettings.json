{
  "DocumentWorkerPool": {
    "Enabled": true,
    "WorkerCount": 2,
    "InteractiveWorkerCount": 0,
    "QueueCapacity": 128,
    "StartupTimeoutSeconds": 30,
    "CommandTimeoutSeconds": 180,
    "SessionAffinityIdleSeconds": 120,
    "MaximumHotSessions": 2,
