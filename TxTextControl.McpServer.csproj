<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TxTextControl.McpServer</AssemblyName>
    <RootNamespace>TxTextControl.McpServer</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <PackageReference Include="TXTextControl.Markdown.Core" Version="34.1.0-beta" />
    <PackageReference Include="TXTextControl.TextControl.Core.SDK" Version="34.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\Requests\Converters\**" />
    <Compile Remove="Tests\**\*.cs" />
    <Content Remove="Models\Requests\Converters\**" />
    <Content Remove="Tests\**\*" />
    <None Remove="Models\Requests\Converters\**" />
    <None Remove="Tests\**\*" />
    <Compile Remove="**\bin\**\*;**\obj\**\*" />
    <Content Remove="**\bin\**\*;**\obj\**\*" />
    <EmbeddedResource Remove="Models\Requests\Converters\**" />
    <None Remove="**\bin\**\*;**\obj\**\*" />
  </ItemGroup>
</Project>
